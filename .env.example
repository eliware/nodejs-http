# Listener
HOST=0.0.0.0
PORT=7001

# Publication and static content
PUBLIC_DIR=./public
BLOG_DIR=./public/content/blogs
STATIC_DIR=./site
STATIC_INDEX_FILE=index.html
INDEX_FILE=index.html
DIRECTORY_TEMPLATE=/srv/repository/directory-listing.html

# Repository browsing
DIRECTORY_INDEX=true
DIRECTORY_LISTING=true
DIRECTORY_REDIRECT=301
ALLOW_DOTFILES=false
ALLOW_SYMLINKS=false

# HTTP security and access
SECURITY_HEADERS=true
CORS_ORIGIN=
ALLOW_GET=true
ALLOW_HEAD=true
BYTE_RANGES=true
ETAG=true
LAST_MODIFIED=true
CACHE_CONTROL=
DEFAULT_MIME_TYPE=application/octet-stream
NOT_FOUND_FILE=
METHOD_NOT_ALLOWED_FILE=

# Logging and timeouts
ACCESS_LOG=true
STRUCTURED_LOGS=true
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=5000
REQUEST_TIMEOUT=30000
HEADERS_TIMEOUT=60000
KEEP_ALIVE_TIMEOUT=5000

# Optional static-asset cache
RAM_CACHE=false
RAM_CACHE_PATHS=/index.html,/directory-listing.html,/web/app.css,/web/app.js,/assets/favicon.ico,/assets/eliware-brand.svg
RAM_CACHE_MAX_BYTES=10485760

# Response compression
COMPRESSION=true
COMPRESSION_MIN_BYTES=256
