{
  "name": "@eliware/nodejs-http",
  "version": "15.2.2",
  "type": "module",
  "description": "Node.js HTTP repository and web frontend.",
  "keywords": [
    "nodejs",
    "repository",
    "http",
    "web"
  ],
  "private": true,
  "main": "./bin/server.mjs",
  "bin": {
    "nodejs-http": "bin/server.mjs"
  },
  "scripts": {
    "start": "node bin/server.mjs",
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "audit": "eliware-test --audit",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check",
    "build": "webpack --config webpack.config.mjs",
    "build:web": "webpack --config webpack.config.mjs",
    "check:blogs": "node scripts/check-blogs.mjs",
    "lighthouse": "node bin/e2e/lighthouse.mjs",
    "screenshots": "node bin/e2e/site-screenshots.mjs",
    "test:e2e:lighthouse": "npm run lighthouse",
    "test:e2e:lighthouse:provided": "LIGHTHOUSE_THROTTLING=provided node bin/e2e/lighthouse.mjs",
    "test:e2e:lighthouse:simulated": "LIGHTHOUSE_THROTTLING=simulate node bin/e2e/lighthouse.mjs",
    "test:e2e:lighthouse:mobile": "LIGHTHOUSE_FORM_FACTOR=mobile LIGHTHOUSE_THROTTLING=provided node bin/e2e/lighthouse.mjs",
    "test:e2e:lighthouse:mobile:simulated": "LIGHTHOUSE_FORM_FACTOR=mobile LIGHTHOUSE_THROTTLING=simulate node bin/e2e/lighthouse.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@eliware/common": "^15.0.1",
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@eliware/test": "^15.2.0",
    "chrome-launcher": "^1.2.3",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "lighthouse": "^13.6.0",
    "mini-css-extract-plugin": "^2.10.2",
    "oxlint": "^1.94.0",
    "prettier": "^3.10.1",
    "puppeteer": "^25.18.1",
    "webpack": "^5.113.0",
    "webpack-cli": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/nodejs-http.git"
  },
  "homepage": "https://github.com/eliware/nodejs-http#readme",
  "bugs": {
    "url": "https://github.com/eliware/nodejs-http/issues"
  },
  "eliware": {
    "id": "E-7100",
    "apply": [
      "general",
      "application",
      "web",
      "ghcr-published"
    ]
  },
  "allowScripts": {
    "puppeteer@25.18.1": true,
    "unrs-resolver": false
  }
}
